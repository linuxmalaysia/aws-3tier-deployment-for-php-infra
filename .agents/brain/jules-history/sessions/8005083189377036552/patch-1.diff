+    &quot;key_id&quot;: &quot;key-ed25519-prod-01&quot;,
+    &quot;verification_status&quot;: &quot;VERIFIED_AI_ENRICHED&quot;,
+    &quot;verification_timestamp&quot;: &quot;2026-08-11T12:00:00+08:00&quot;,
+    &quot;signature_algorithm&quot;: &quot;Ed25519&quot;,
+    &quot;signature_encoding&quot;: &quot;HEX_RAW_64_BYTE&quot;
+  }
+}
