+                    for u in root.findall(f"{SITEMAP_NS}url")
+                    if u.find(f"{SITEMAP_NS}loc") is not None
+                    and u.find(f"{SITEMAP_NS}loc").text == GH_URL
+                ]
+                self.assertEqual(len(matches), 1)
+
+    def test_new_url_node_has_expected_fields(self):
