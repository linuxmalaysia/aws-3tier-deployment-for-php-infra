+|                           | &lt;------------------- |  - Git Push &amp; PR Reply    |
+|                           |    Telemetry &amp; Diff  |                           |
++---------------------------+                      +---------------------------+
+```
+
+#### Delegation Script Example (`scripts/antigravity_to_jules.py`)
+
+```python
+#!/usr/bin/env python3
+&quot;&quot;&quot;Programmatic task delegation from Google Antigravity to Google Jules API.&quot;&quot;&quot;
+
+import os
+import requests
+
+JULES_SESSIONS_URL = &quot;https://jules.googleapis.com/v1alpha/sessions&quot;
+JULES_SOURCES_URL = &quot;https://jules.googleapis.com/v1alpha/sources&quot;
+
+api_key = os.getenv(&quot;JULES_API_KEY&quot;)
+if not api_key:
+    raise ValueError(&quot;JULES_API_KEY environment variable is required.&quot;)
+
+headers = {
+    &quot;X-Goog-Api-Key&quot;: api_key,
+    &quot;Content-Type&quot;: &quot;application/json&quot;
+}
+
+# 1. Resolve source name for target repository with pagination
+target_owner = &quot;linuxmalaysia&quot;
+target_repo = &quot;aws-3tier-deployment-for-php-infra&quot;
+source_name = None
+next_page_token = None
+
+while True:
+    params = {}
+    if next_page_token:
+        params[&quot;pageToken&quot;] = next_page_token
+
+    sources_resp = requests.get(JULES_SOURCES_URL, headers=headers, params=params, timeout=30)
+    sources_resp.raise_for_status()
+    sources_data = sources_resp.json()
+
+    for src in sources_data.get(&quot;sources&quot;, []):
+        gh_repo = src.get(&quot;githubRepo&quot;, {})
+        if gh_repo.get(&quot;owner&quot;) == target_owner and gh_repo.get(&quot;repo&quot;) == target_repo:
+            source_name = src.get(&quot;name&quot;)
+            break
+
+    if source_name:
+        break
+
+    next_page_token = sources_data.get(&quot;nextPageToken&quot;)
+    if not next_page_token:
+        break
+
+if not source_name:
+    raise RuntimeError(
+        f&quot;No connected Jules source found matching repository &apos;{target_owner}/{target_repo}&apos;.&quot;
+    )
+
+# 2. Dispatch session request to Jules
+payload = {
+    &quot;prompt&quot;: (
+        &quot;1. Check all OpenTofu modules for compliance with IMDSv2.\n&quot;
+        &quot;2. Run prepare_docs.py to reformat headers.\n&quot;
+        &quot;3. Execute pytest suite to confirm zero regressions.&quot;
+    ),
+    &quot;sourceContext&quot;: {
+        &quot;source&quot;: source_name,
+        &quot;githubRepoContext&quot;: {
+            &quot;startingBranch&quot;: &quot;main&quot;
+        }
+    },
+    &quot;automationMode&quot;: &quot;AUTO_CREATE_PR&quot;
+}
+
+response = requests.post(JULES_SESSIONS_URL, headers=headers, json=payload, timeout=30)
+response.raise_for_status()
+res_json = response.json()
+
+session_id = res_json.get(&quot;name&quot;) or res_json.get(&quot;id&quot;)
+print(f&quot;Session successfully dispatched to Jules. Session ID: {session_id}&quot;)
+```
