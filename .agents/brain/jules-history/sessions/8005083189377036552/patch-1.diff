+    "engineering/aws-cli-guide.html"
+)
+EXPECTED_GB_URL = (
+    "https://linuxmalaysia.gitbook.io/aws-3tier-deployment-for-php-infra/"
+    "docs/engineering/aws-cli-guide"
+)
+
+SITEMAP_XML_NS = "{http://www.sitemaps.org/schemas/sitemap/0.9}"
