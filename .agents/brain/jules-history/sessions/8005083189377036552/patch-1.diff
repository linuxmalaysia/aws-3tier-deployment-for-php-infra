+    "100 VU",
+    "500 VU",
+    "1,000 VU",
+    "2,500 VU",
+    "5,000 VU",
+    "10,000 VU",
+]
+
+USD_TO_MYR_RATE = 4.50
+
+
+def to_decimal(val):
+    if isinstance(val, float):
+        val = f"{val:.4f}"
+    return Decimal(str(val)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
+
+
+def _read(path):
+    with open(path, "r", encoding="utf-8") as f:
